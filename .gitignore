# Overview:
# - Purpose: Ignore generated or machine-specific files.
# - Used by: Git when determining what should be committed.
# - Adds: Cleaner history and fewer accidental commits.
# - Learn more: https://git-scm.com/docs/gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
.envs/
env/
venv/
ENV/
env.bak/
venv.bak/

# Generated API docs
docs/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

#prototypes
prototype_output/
*.npy

# Python
.ruff_cache/

# IDE
.idea/

# Environments
.venv/
envs/

# Local scientific playtest data
Playtest_model/**/*.h5
Playtest_model/**/*.bin
Playtest_model/**/prototype_output/

# Generated scientific outputs
*.npz
*.tif
*.tiff

# Raw acquisitions
Playtest_model/**/*.hdf5

# Generated analytical arrays and images
Playtest_model/**/*.npy
Playtest_model/**/*.npz
Playtest_model/**/*.tif
Playtest_model/**/*.tiff
Playtest_model/**/*.png
Playtest_model/**/*.jpg
Playtest_model/**/*.jpeg

# Local exploratory outputs
Playtest_model/**/*_diagnostic.txt
Playtest_model/**/*_summary.txt
Playtest_model/**/*_diagnostic.csv
Playtest_model/**/*_profiles.csv

# Track the lightweight playtest documentation
!Playtest_model/**/README.md
!Playtest_model/**/manifest.json
!Playtest_model/**/expected_outputs.txt
Playtest_model/**
!Playtest_model/README.md
!Playtest_model/Testmodel_1_quadrant/
!Playtest_model/Testmodel_1_quadrant/README.md
!Playtest_model/Testmodel_4_quadrant/
!Playtest_model/Testmodel_4_quadrant/README.md

# Local pipeline outputs outside Playtest_model
md_output/
**/prototype_output/
**/stitched_output/

# IDE and operating-system metadata
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Local maintenance reports
repository_cleanup_audit.json
repository_cleanup_plan.json

# Applied patch delivery artifacts
*_patch/
*_hotfix/
*_patch.zip
*_hotfix.zip